FROM ghcr.io/codelibs/fess:14.19.0

USER root

# 一太郎Extractor JAR
COPY fess-1taroextractor-1.0.0-all.jar /usr/share/fess/app/WEB-INF/lib/

# テスト用ドキュメント
COPY documents /documents

CMD ["sh", "-c", "FESS_LIB=/usr/share/fess/app/WEB-INF/lib && CP=$(find $FESS_LIB -name '*.jar' | tr '\\n' ':') && java -cp $CP com.github.matsu582.fess.extractor.TestMain /documents"]
